<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  MODELLO INATTIVO del job Scuola (school_job.py). Non e' caricato da nessuno: lo installa solo
  `school_job_launchd.sh install - -conferma` (vedi docs/automazione-scuola.md), che sostituisce i segnaposto @...@.
  Nessuna credenziale qui: il job legge il Portachiavi della sessione utente.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>cloud.scuola.job</string>
  <key>ProgramArguments</key>
  <array>
    <string>@PYTHON@</string>
    <string>@JOB@</string>
    <string>check</string>
  </array>
  <!-- 14/11: nessun orario fisso (alle 6:45 il Mac e' chiuso). Ogni 5 minuti, e al risveglio, `check` decide: giro se
       e' stato chiesto dal telefono, oppure se i dati hanno piu' di 3 ore e il Mac e' in uso; altrimenti esce subito. -->
  <key>StartInterval</key>
  <integer>300</integer>
  <!-- anche all'accesso (dopo un riavvio o a Mac rimasto spento); il lock del job evita sovrapposizioni -->
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONIOENCODING</key>
    <string>utf-8</string>
    <key>LANG</key>
    <string>it_IT.UTF-8</string>
  </dict>
  <!-- il riepilogo completo e' in last_summary.json e nel log JSON con rotazione; qui solo gli errori imprevisti -->
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/Cloud/school-job.err.log</string>
</dict>
</plist>
